	measure 'Hạng ngành' =
			IF (
			    ISINSCOPE ( dim_industry[industry_name] ) && NOT ISBLANK ( [Dư nợ] ),
			    RANKX ( ALLSELECTED ( dim_industry[industry_name] ), [Dư nợ], , DESC )
			)
		formatString: 0
		lineageTag: 12674090-03ac-44ed-87cd-ff70dbb9c803
		displayFolder: 99 Trung gian
		isHidden

	measure 'Là Top 10 ngành' = VAR r = [Hạng ngành] RETURN NOT ISBLANK ( r ) && r <= 10
		lineageTag: 26b17eb9-db62-43d3-bbf4-aa72c007fec0
		displayFolder: 99 Trung gian
		isHidden

	measure 'Dư nợ Top 10 ngành' = IF ( [Là Top 10 ngành], [Dư nợ] )
		formatString: #,0
		lineageTag: 01b868fc-e3d9-4150-9659-593ee86c27c5
		displayFolder: 07 Top 10\Ngành

	measure 'Nhãn OD ngành' =
			IF (
			    [Là Top 10 ngành],
			    "OD2 " & FORMAT ( [Tỷ lệ OD2] * 100, "0.0", "vi-VN" ) & "% · OD3-5 "
			        & FORMAT ( [Tỷ lệ OD35] * 100, "0.0", "vi-VN" ) & "%"
			)
		lineageTag: 693e163c-47d8-4519-9174-2a48dca2497d
		displayFolder: 07 Top 10\Ngành

	measure 'Cơ cấu nhóm nợ (SVG)' =
			VAR W = 200
			VAR H = 22
			VAR tot = [Dư nợ]
			VAR w1 = DIVIDE ( CALCULATE ( [Dư nợ], dim_debt_group[debt_group_code] = "NORM" ), tot ) * W
			VAR w2 = DIVIDE ( CALCULATE ( [Dư nợ], dim_debt_group[debt_group_code] = "OD2" ), tot ) * W
			VAR w3 = DIVIDE ( CALCULATE ( [Dư nợ], dim_debt_group[debt_group_code] = "OD3" ), tot ) * W
			VAR w4 = DIVIDE ( CALCULATE ( [Dư nợ], dim_debt_group[debt_group_code] = "OD4" ), tot ) * W
			VAR w5 = DIVIDE ( CALCULATE ( [Dư nợ], dim_debt_group[debt_group_code] = "OD5" ), tot ) * W
			VAR x1 = 0
			VAR x2 = x1 + w1
			VAR x3 = x2 + w2
			VAR x4 = x3 + w3
			VAR x5 = x4 + w4
			RETURN
			    IF (
			        [Là Top 10 ngành],
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & W & "' height='" & H & "'>"
			            & "<rect x='" & FORMAT ( x1, "0.00", "en-US" ) & "' y='3' width='" & FORMAT ( w1 + 0, "0.00", "en-US" ) & "' height='" & H - 6 & "' fill='%23D3E4C6'/>"
			            & "<rect x='" & FORMAT ( x2, "0.00", "en-US" ) & "' y='3' width='" & FORMAT ( w2 + 0, "0.00", "en-US" ) & "' height='" & H - 6 & "' fill='%231E3A14'/>"
			            & "<rect x='" & FORMAT ( x3, "0.00", "en-US" ) & "' y='3' width='" & FORMAT ( w3 + 0, "0.00", "en-US" ) & "' height='" & H - 6 & "' fill='%235FA043'/>"
			            & "<rect x='" & FORMAT ( x4, "0.00", "en-US" ) & "' y='3' width='" & FORMAT ( w4 + 0, "0.00", "en-US" ) & "' height='" & H - 6 & "' fill='%23128070'/>"
			            & "<rect x='" & FORMAT ( x5, "0.00", "en-US" ) & "' y='3' width='" & FORMAT ( w5 + 0, "0.00", "en-US" ) & "' height='" & H - 6 & "' fill='%23EFD99A'/>"
			            & "</svg>"
			    )
		lineageTag: 04aaf048-15e0-4dbe-9221-48590f75e17a
		dataCategory: ImageUrl
		displayFolder: 07 Top 10\Ngành

	measure 'Hạng ĐVKD' =
