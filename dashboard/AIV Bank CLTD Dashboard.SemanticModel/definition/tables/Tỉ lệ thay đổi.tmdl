			RETURN IF ( ISBLANK ( d ), "–", IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ) * 100, "0.00", "vi-VN" ) & " điểm %" )
		displayFolder: 04 KPI card

