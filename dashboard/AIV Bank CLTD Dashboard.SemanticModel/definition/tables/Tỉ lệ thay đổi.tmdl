	measure 'OD2 Δ tháng' =
			VAR d = [OD2 Δ tháng (giá trị)]
			RETURN
			    IF (
			        NOT ISBLANK ( d ),
			        IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ) * 100, "0.00", "vi-VN" ) & " điểm % so với cuối tháng trước"
			    )
		displayFolder: KPI hiển thị
		lineageTag: 868831e0-bb59-47eb-9d00-6396bfadf975

