	measure 'Màu Δ NIM chương trình' =
			VAR x = [Δ NIM YTD (điểm %)]
			RETURN IF ( ISBLANK ( x ) || ABS ( x ) < 0.005, "#5F5E5A", IF ( x > 0, "#447A2A", "#A32D2D" ) )
		displayFolder: 10 Phân tích sâu\Màu
		lineageTag: adb99805-d8c7-46f3-add3-9997b47b7829

	measure 'Màu đóng góp Δ NIM' =
