	measure 'Tiêu đề Hình 4' = "Hình 4: Cơ cấu dư nợ theo phân khúc tại " & [Ngày báo cáo]
		displayFolder: KPI hiển thị

	measure 'Tiêu đề Hình 5' = "Hình 5: Dư nợ theo ngành tại " & [Ngày báo cáo] & " (tỷ đồng)"
		displayFolder: KPI hiển thị

	measure 'Tiêu đề Hình 7' = "Hình 7: Top 10 ĐVKD theo dư nợ tại " & [Ngày báo cáo] & " (tỷ đồng)"
		displayFolder: KPI hiển thị

	measure 'Tiêu đề Hình 8' = "Hình 8: NII YTD theo phân khúc đến " & [Ngày báo cáo]
		displayFolder: KPI hiển thị

	measure 'Tiêu đề Hình 10' = "Hình 10: Top 10 khách hàng theo NII YTD đến " & [Ngày báo cáo] & " (tỷ đồng)"
