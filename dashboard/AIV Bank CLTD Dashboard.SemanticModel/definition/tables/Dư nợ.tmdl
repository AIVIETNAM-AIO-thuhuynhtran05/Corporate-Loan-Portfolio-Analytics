	measure 'Tỷ trọng DNBQ YTD' = DIVIDE ( [DNBQ YTD], CALCULATE ( [DNBQ YTD], ALLSELECTED ( dim_campaign ) ) )
		formatString: 0.0%
		displayFolder: 10 Phân tích sâu\Chương trình
		lineageTag: 84c79fad-567a-45cc-9653-1143c865fcda

	measure 'Δ NIM YTD (điểm %)' = IF ( NOT ISBLANK ( [NIM YTD] ) && NOT ISBLANK ( [NIM YTD LY] ), ( [NIM YTD] - [NIM YTD LY] ) * 100 )
		formatString: +0.00;-0.00;0.00
		displayFolder: 10 Phân tích sâu\Chương trình
		lineageTag: fdf889eb-eb7d-4ab5-8775-793f1432826d

	measure 'Đóng góp Δ NIM (điểm %)' =
			// Tách thay đổi NIM YTD so với cùng kỳ: hiệu ứng cơ cấu (w1 - w0) * (n0 - N0) + hiệu ứng biên w1 * (n1 - n0).
			// Nhóm mới xuất hiện / không còn lấy NIM hiện có làm gốc, để không tính nhầm cả nhóm thành hiệu ứng biên.
			VAR a1 = [DNBQ YTD]
			VAR a0 = [DNBQ YTD LY]
			VAR w1 = DIVIDE ( a1, CALCULATE ( [DNBQ YTD], ALLSELECTED ( dim_campaign ) ) ) + 0
			VAR w0 = DIVIDE ( a0, CALCULATE ( [DNBQ YTD LY], ALLSELECTED ( dim_campaign ) ) ) + 0
			VAR n1 = [NIM YTD]
			VAR n0 = [NIM YTD LY]
			VAR b0 = IF ( ISBLANK ( n0 ), n1, n0 )
			VAR b1 = IF ( ISBLANK ( n1 ), n0, n1 )
			VAR N0 = CALCULATE ( [NIM YTD LY], ALLSELECTED ( dim_campaign ) )
			RETURN
				IF (
					ISINSCOPE ( dim_campaign[campaign_name] ),
					IF ( NOT ( ISBLANK ( a1 ) && ISBLANK ( a0 ) ), ( ( w1 - w0 ) * ( b0 - N0 ) + w1 * ( b1 - b0 ) ) * 100 ),
					[Δ NIM YTD (điểm %)]
				)
		formatString: +0.00;-0.00;0.00
		displayFolder: 10 Phân tích sâu\Chương trình
		lineageTag: 048366a7-4a55-462c-8765-c1f5f3a25cfc

	measure 'KH NII YTD' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR y = YEAR ( d )
			RETURN CALCULATE ( SUM ( fact_plan[plan_nii_vnd] ), fact_plan[month_id] >= y * 100 + 1, fact_plan[month_id] <= y * 100 + MONTH ( d ) )
		formatString: #,0
		displayFolder: 10 Phân tích sâu\Kế hoạch
		lineageTag: a6f23090-b8c7-46ae-ab50-a74b97763a1a

