		displayFolder: KPI hiển thị

	measure 'Kỳ hạn DN hiện tại' = IF ( ISBLANK ( [Dư nợ (tỷ)] ), "–", FORMAT ( [Dư nợ (tỷ)], "#,0.0", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'Kỳ hạn DN cuối tháng trước' = IF ( ISBLANK ( [Dư nợ LM (tỷ)] ), "–", FORMAT ( [Dư nợ LM (tỷ)], "#,0.0", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'Kỳ hạn DN cùng tháng năm trước' = IF ( ISBLANK ( [Dư nợ LY (tỷ)] ), "–", FORMAT ( [Dư nợ LY (tỷ)], "#,0.0", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'Kỳ hạn DN Δ tháng' =
			VAR d = [Dư nợ Δ tháng (giá trị)]
			RETURN IF ( ISBLANK ( d ), "–", IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ), "0.0%", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'Kỳ hạn DN Δ cùng kỳ' =
			VAR d = [Dư nợ Δ cùng kỳ (giá trị)]
			RETURN IF ( ISBLANK ( d ), "–", IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ), "0.0%", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'Kỳ hạn DN tỷ trọng' =
			VAR tot = CALCULATE ( [Dư nợ], ALLSELECTED ( dim_loan_contract[Kỳ hạn], dim_loan_contract[Thứ tự kỳ hạn] ) )
			RETURN IF ( NOT ISBLANK ( [Dư nợ] ), FORMAT ( DIVIDE ( [Dư nợ], tot ), "0.0%", "vi-VN" ) )
		displayFolder: Bảng dư nợ

	measure 'ĐVKD DN hiện tại' = IF ( [Là Top 10 ĐVKD], IF ( ISBLANK ( [Dư nợ (tỷ)] ), "–", FORMAT ( [Dư nợ (tỷ)], "#,0.0", "vi-VN" ) ) )
		displayFolder: Bảng dư nợ

	measure 'ĐVKD DN cuối tháng trước' = IF ( [Là Top 10 ĐVKD], IF ( ISBLANK ( [Dư nợ LM (tỷ)] ), "–", FORMAT ( [Dư nợ LM (tỷ)], "#,0.0", "vi-VN" ) ) )
		displayFolder: Bảng dư nợ

	measure 'ĐVKD DN cùng tháng năm trước' = IF ( [Là Top 10 ĐVKD], IF ( ISBLANK ( [Dư nợ LY (tỷ)] ), "–", FORMAT ( [Dư nợ LY (tỷ)], "#,0.0", "vi-VN" ) ) )
		displayFolder: Bảng dư nợ

	measure 'ĐVKD DN Δ tháng' = ```
			IF ( [Là Top 10 ĐVKD], 
			VAR d = [Dư nợ Δ tháng (giá trị)]
			RETURN IF ( ISBLANK ( d ), "–", IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ), "0.0%", "vi-VN" ) ) )
			```
		displayFolder: Bảng dư nợ

	measure 'ĐVKD DN Δ cùng kỳ' = ```
			IF ( [Là Top 10 ĐVKD], 
			VAR d = [Dư nợ Δ cùng kỳ (giá trị)]
			RETURN IF ( ISBLANK ( d ), "–", IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( d ), "0.0%", "vi-VN" ) ) )
			```
		displayFolder: Bảng dư nợ

	measure 'STT Top 10 ĐVKD' = IF ( [Là Top 10 ĐVKD], [Hạng ĐVKD] )
		formatString: 0
		displayFolder: Bảng dư nợ

	measure 'Phân khúc KH' = LOOKUPVALUE ( dim_segment[segment], dim_segment[segment_id], SELECTEDVALUE ( dim_customer[segment_id] ) )
		displayFolder: Top 10 NII/TOI

	measure 'Hạng KH NII YTD' =
			IF (
			    ISINSCOPE ( dim_customer[Khách hàng] ) && [NII YTD] > 0,
			    RANKX ( FILTER ( ALLSELECTED ( dim_customer[Khách hàng] ), [NII YTD] > 0 ), [NII YTD], , DESC )
			)
		formatString: 0
		displayFolder: Top 10 NII/TOI

	measure 'STT KH NII YTD' = VAR r = [Hạng KH NII YTD] RETURN IF ( NOT ISBLANK ( r ) && r <= 10, r )
		formatString: 0
		displayFolder: Top 10 NII/TOI

	measure 'KH NII YTD (tỷ)' = IF ( NOT ISBLANK ( [STT KH NII YTD] ), FORMAT ( [NII YTD], "#,0.00", "vi-VN" ) )
		displayFolder: Top 10 NII/TOI

	measure 'KH NII YTD phân khúc' = IF ( NOT ISBLANK ( [STT KH NII YTD] ), [Phân khúc KH] )
		displayFolder: Top 10 NII/TOI

	measure 'Hạng ĐVKD NII YTD' =
			IF (
			    ISINSCOPE ( dim_branch[ĐVKD] ) && [NII YTD] > 0,
			    RANKX ( FILTER ( ALLSELECTED ( dim_branch[ĐVKD] ), [NII YTD] > 0 ), [NII YTD], , DESC )
			)
		formatString: 0
		displayFolder: Top 10 NII/TOI

	measure 'NII YTD Top 10 ĐVKD' = VAR r = [Hạng ĐVKD NII YTD] RETURN IF ( NOT ISBLANK ( r ) && r <= 10, [NII YTD] )
		formatString: #,0
		displayFolder: Top 10 NII/TOI

	measure 'Hạng KH TOI YTD' =
			IF (
			    ISINSCOPE ( dim_customer[Khách hàng] ) && [TOI YTD] > 0,
			    RANKX ( FILTER ( ALLSELECTED ( dim_customer[Khách hàng] ), [TOI YTD] > 0 ), [TOI YTD], , DESC )
			)
		formatString: 0
		displayFolder: Top 10 NII/TOI

