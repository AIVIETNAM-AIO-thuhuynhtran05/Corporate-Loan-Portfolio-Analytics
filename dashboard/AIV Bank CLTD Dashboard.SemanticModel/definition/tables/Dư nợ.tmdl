	measure 'LS BQ ngắn hạn VND' =
			// Lãi suất bình quân gia quyền theo dư nợ, chỉ HĐ ngắn hạn VND để không bị lẫn cơ cấu loại tiền / kỳ hạn
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN
				CALCULATE (
					DIVIDE (
						SUMX ( fact_loan_balance, fact_loan_balance[balance_vnd] * RELATED ( dim_loan_contract[interest_rate_pct] ) ),
						SUM ( fact_loan_balance[balance_vnd] )
					) / 100,
					REMOVEFILTERS ( dim_date ),
					dim_date[date] = d,
					dim_loan_contract[term_group] = "ST",
					dim_loan_contract[ccy] = "VND"
				)
		formatString: 0.00%
		displayFolder: 10 Phân tích sâu\Xếp hạng
		lineageTag: d58ac52c-ebdf-499a-9d76-0a63a2057a91

	measure 'Thứ tự xếp hạng' = SWITCH ( SELECTEDVALUE ( dim_customer[credit_rating] ), "AAA", 1, "AA", 2, "A", 3, "BBB", 4, "BB", 5, "B", 6, "CCC", 7 )
		formatString: 0
		displayFolder: 10 Phân tích sâu\Xếp hạng
		lineageTag: e6825ca6-2eec-487e-8554-6983acab6abc

	measure 'Số KH còn dư nợ' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN CALCULATE ( COUNTROWS ( SUMMARIZE ( fact_loan_balance, dim_loan_contract[cif] ) ), REMOVEFILTERS ( dim_date ), dim_date[date] = d )
		formatString: #,0
		displayFolder: 10 Phân tích sâu\Khách hàng
		lineageTag: 45e2c058-6772-45e5-b556-e8df721e60cc

	measure 'Dư nợ BQ/KH (tỷ)' = DIVIDE ( [Dư nợ (tỷ)], [Số KH còn dư nợ] )
		formatString: #,0.00
		displayFolder: 10 Phân tích sâu\Khách hàng
		lineageTag: f3c2bcd0-3f23-4f07-bb0a-7ddd9af4108c

	measure 'Xu hướng Số KH còn dư nợ' =
			VAR sel = MAX ( dim_date[month_end_date] )
			VAR mth = MAX ( 'Trục tháng'[Tháng] )
			RETURN IF ( mth <= sel, CALCULATE ( [Số KH còn dư nợ], dim_date[month_end_date] = mth ) )
		formatString: #,0
		displayFolder: 10 Phân tích sâu\Xu hướng
		lineageTag: b149ea60-d342-424f-88a5-df87515f4cc6

	measure 'Xu hướng Dư nợ BQ/KH' =
			VAR sel = MAX ( dim_date[month_end_date] )
			VAR mth = MAX ( 'Trục tháng'[Tháng] )
			RETURN IF ( mth <= sel, CALCULATE ( [Dư nợ BQ/KH (tỷ)], dim_date[month_end_date] = mth ) )
		formatString: #,0.00
		displayFolder: 10 Phân tích sâu\Xu hướng
		lineageTag: a6ddbe58-47b4-4502-a7e3-878bfa6b7fab

	measure 'Tỷ trọng TOI YTD top 20% KH' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR s = DATE ( YEAR ( d ), 1, 1 )
			VAR t =
				CALCULATETABLE (
					ADDCOLUMNS ( SUMMARIZE ( fact_income_monthly, dim_loan_contract[cif] ), "@v", CALCULATE ( SUM ( fact_income_monthly[toi_mtd] ) ) ),
					fact_income_monthly[period_end_date] >= s,
					fact_income_monthly[period_end_date] <= d
				)
			VAR k = ROUNDUP ( COUNTROWS ( t ) * 0.2, 0 )
			RETURN DIVIDE ( SUMX ( TOPN ( k, t, [@v], DESC ), [@v] ), SUMX ( t, [@v] ) )
		formatString: 0.0%
		displayFolder: 10 Phân tích sâu\Tập trung
		lineageTag: fc6504d2-2a62-4fd7-9aa6-97d07e55cc3e

	measure 'Tỷ trọng dư nợ top 20% KH' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR t =
				CALCULATETABLE (
					ADDCOLUMNS ( SUMMARIZE ( fact_loan_balance, dim_loan_contract[cif] ), "@v", CALCULATE ( SUM ( fact_loan_balance[balance_vnd] ) ) ),
					REMOVEFILTERS ( dim_date ),
					dim_date[date] = d
				)
			VAR k = ROUNDUP ( COUNTROWS ( t ) * 0.2, 0 )
			RETURN DIVIDE ( SUMX ( TOPN ( k, t, [@v], DESC ), [@v] ), SUMX ( t, [@v] ) )
		formatString: 0.0%
		displayFolder: 10 Phân tích sâu\Tập trung
		lineageTag: 5ec797bb-1d02-4cac-8ff6-86641a717558

	measure 'KPI Tỷ trọng TOI top 20% KH' = IF ( ISBLANK ( [Tỷ trọng TOI YTD top 20% KH] ), "–", FORMAT ( [Tỷ trọng TOI YTD top 20% KH] * 100, "#,0.0", "vi-VN" ) )
		displayFolder: 10 Phân tích sâu\KPI
		lineageTag: 88926c6b-9e95-4e7f-9b63-b8718696920f

	measure 'Nhãn dư nợ top 20% KH' = IF ( ISBLANK ( [Tỷ trọng dư nợ top 20% KH] ), "–", FORMAT ( [Tỷ trọng dư nợ top 20% KH], "0.0%", "vi-VN" ) & " dư nợ" )
		displayFolder: 10 Phân tích sâu\KPI
		lineageTag: 23a751a9-c9d0-4fe3-9f82-1a03f3474d2f

	measure 'Nhãn KH TOI âm' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR s = DATE ( YEAR ( d ), 1, 1 )
			VAR t =
				CALCULATETABLE (
					ADDCOLUMNS ( SUMMARIZE ( fact_income_monthly, dim_loan_contract[cif] ), "@v", CALCULATE ( SUM ( fact_income_monthly[toi_mtd] ) ) ),
					fact_income_monthly[period_end_date] >= s,
					fact_income_monthly[period_end_date] <= d
				)
			VAR neg = FILTER ( t, [@v] < 0 )
			RETURN IF ( ISEMPTY ( t ), "–", FORMAT ( COUNTROWS ( neg ) + 0, "#,0", "vi-VN" ) & " KH  ·  " & FORMAT ( SUMX ( neg, [@v] ) / 1e9 + 0, "#,0.0", "vi-VN" ) & " tỷ" )
		displayFolder: 10 Phân tích sâu\KPI
		lineageTag: 22196200-7572-4d11-8cc4-ed9a83f4c604

	measure 'Tiêu đề Hình 20' = "Hình 20: NIM năm hoá theo tháng, toàn danh mục và theo kỳ hạn (%)"
