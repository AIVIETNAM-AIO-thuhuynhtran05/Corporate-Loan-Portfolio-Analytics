			RETURN
				IF (
					ISBLANK ( a ) || ISBLANK ( n ), "–",
					"DNBQ " & IF ( a > 0, UNICHAR ( 9650 ), IF ( a < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( a ), "0.0%", "vi-VN" )
						& "  ·  NII " & IF ( n > 0, UNICHAR ( 9650 ), IF ( n < 0, UNICHAR ( 9660 ), UNICHAR ( 8594 ) ) ) & " " & FORMAT ( ABS ( n ), "0.0%", "vi-VN" )
				)
		displayFolder: 10 Phân tích sâu\KPI
