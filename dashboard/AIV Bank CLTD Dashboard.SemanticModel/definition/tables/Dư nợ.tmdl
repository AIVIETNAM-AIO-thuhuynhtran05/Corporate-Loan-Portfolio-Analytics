	measure 'Tỷ lệ OD3-5 loại KV đột biến LY' = CALCULATE ( [Tỷ lệ OD35 LY], fact_loan_balance[contract_id] <> "AIV-LN-0007842" )
		formatString: 0.00%
		displayFolder: 10 Phân tích sâu\Nợ xấu
		lineageTag: 194bcd37-1acb-4542-92e8-b77d87b47fb2

	measure 'Tỷ lệ OD3-5 theo nhóm xấu nhất KH' =
			// Mỗi KH được quy về nhóm nợ cao nhất trong các HĐ của KH đó (cách CIC dùng)
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN
				CALCULATE (
					VAR t =
						ADDCOLUMNS (
							SUMMARIZE ( fact_loan_balance, dim_loan_contract[cif] ),
							"@w", CALCULATE ( MAX ( fact_loan_balance[debt_group_id] ) ),
							"@b", CALCULATE ( SUM ( fact_loan_balance[balance_vnd] ) )
						)
					RETURN DIVIDE ( SUMX ( FILTER ( t, [@w] >= 3 ), [@b] ), SUMX ( t, [@b] ) ) + 0,
					REMOVEFILTERS ( dim_date ),
					dim_date[date] = d,
					REMOVEFILTERS ( dim_debt_group )
				)
		formatString: 0.00%
		displayFolder: 10 Phân tích sâu\Nợ xấu
		lineageTag: beacc196-1e6a-4026-96c5-403cbd4147ef

