table 'Dư nợ'
	lineageTag: df4f3f43-9ac6-44c1-b811-ff5173b1ac8d

	measure 'Dư nợ' =
			
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN CALCULATE ( SUM ( fact_loan_balance[balance_vnd] ), REMOVEFILTERS ( dim_date ), dim_date[date] = d )
		formatString: 0
		lineageTag: 9218f940-5190-46a2-b63a-14531f7cf7de
		displayFolder: 01 Dư nợ

	measure 'Dư nợ LM' =
			
			VAR d = MAX ( dim_date[prev_month_end] )
			RETURN CALCULATE ( SUM ( fact_loan_balance[balance_vnd] ), REMOVEFILTERS ( dim_date ), dim_date[date] = d )
		formatString: 0
		lineageTag: 0537f656-3d49-4645-8b8b-02496f227e87
		displayFolder: 01 Dư nợ

	measure 'Dư nợ LY' =
			
			VAR d = MAX ( dim_date[same_month_prev_year_end] )
			RETURN CALCULATE ( SUM ( fact_loan_balance[balance_vnd] ), REMOVEFILTERS ( dim_date ), dim_date[date] = d )
		formatString: 0
		lineageTag: 08d33886-d9c4-4bf9-9001-9ed3b48a806c
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD2' = CALCULATE ( [Dư nợ],    dim_debt_group[is_od2] = TRUE () )
		formatString: 0
		lineageTag: 1d4a11e3-368a-4b1d-b26f-0104d49eab57
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD2 LM' = CALCULATE ( [Dư nợ LM], dim_debt_group[is_od2] = TRUE () )
		formatString: 0
		lineageTag: 00cb5b93-982f-4f4c-ba0d-2725c54ada83
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD2 LY' = CALCULATE ( [Dư nợ LY], dim_debt_group[is_od2] = TRUE ())
		formatString: 0
		lineageTag: 3a700343-056e-44f6-8cef-1c1f01cb3bee
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD35' = CALCULATE ( [Dư nợ],    dim_debt_group[is_od35] = TRUE () )
		formatString: 0
		lineageTag: 0fdaed41-86f4-4d86-9d47-b9a9a3787a6b
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD35 LM' = CALCULATE ( [Dư nợ LM], dim_debt_group[is_od35] = TRUE () )
		formatString: 0
		lineageTag: 5111db8d-0538-463f-90e2-e315321a032f
		displayFolder: 01 Dư nợ

	measure 'Dư nợ OD35 LY' = CALCULATE ( [Dư nợ LY], dim_debt_group[is_od35] = TRUE () )
		formatString: 0
		lineageTag: 966e8af8-474e-442b-8790-2bfeb33f0f7e
		displayFolder: 01 Dư nợ

	measure 'Dư nợ (tỷ)' = DIVIDE ( [Dư nợ], 1e9 )
		formatString: #,0.0
		displayFolder: 01 Dư nợ

	measure 'Dư nợ LM (tỷ)' = DIVIDE ( [Dư nợ LM], 1e9 )
		formatString: #,0.0
		displayFolder: 01 Dư nợ

	measure 'Dư nợ LY (tỷ)' = DIVIDE ( [Dư nợ LY], 1e9 )
		formatString: #,0.0
		displayFolder: 01 Dư nợ

	measure 'NII tháng' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN DIVIDE ( CALCULATE ( SUM ( fact_income_monthly[nii_mtd] ), TREATAS ( { d }, fact_income_monthly[period_end_date] ) ), 1e9 )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'NII YTD' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR s = DATE ( YEAR ( d ), 1, 1 )
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( fact_income_monthly[nii_mtd] ), fact_income_monthly[period_end_date] >= s, fact_income_monthly[period_end_date] <= d ),
			        1e9
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'TOI tháng' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN DIVIDE ( CALCULATE ( SUM ( fact_income_monthly[toi_mtd] ), TREATAS ( { d }, fact_income_monthly[period_end_date] ) ), 1e9 )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'TOI YTD' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR s = DATE ( YEAR ( d ), 1, 1 )
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( fact_income_monthly[toi_mtd] ), fact_income_monthly[period_end_date] >= s, fact_income_monthly[period_end_date] <= d ),
			        1e9
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'DNBQ YTD' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR s = DATE ( YEAR ( d ), 1, 1 )
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( fact_income_monthly[avg_balance_vnd] ), fact_income_monthly[period_end_date] >= s, fact_income_monthly[period_end_date] <= d ),
			        MONTH ( d ) * 1e9
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'NII YTD LM' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN
			    IF (
			        MONTH ( d ) > 1,
			        CALCULATE ( [NII YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -1 ) )
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'NII YTD LY' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN CALCULATE ( [NII YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -12 ) )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'TOI YTD LM' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN
			    IF (
			        MONTH ( d ) > 1,
			        CALCULATE ( [TOI YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -1 ) )
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'TOI YTD LY' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN CALCULATE ( [TOI YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -12 ) )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'DNBQ YTD LM' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN
			    IF (
			        MONTH ( d ) > 1,
			        CALCULATE ( [DNBQ YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -1 ) )
			    )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'DNBQ YTD LY' =
			VAR d = MAX ( dim_date[month_end_date] )
			RETURN CALCULATE ( [DNBQ YTD], REMOVEFILTERS ( dim_date ), dim_date[month_end_date] = EOMONTH ( d, -12 ) )
		formatString: #,0.0
		displayFolder: 02 Thu nhập & DNBQ

	measure 'KPI Dư nợ' = IF ( ISBLANK ( [Dư nợ (tỷ)] ), "–", FORMAT ( [Dư nợ (tỷ)], "#,0.0", "vi-VN" ) )
		displayFolder: 04 KPI card

	measure 'Dư nợ Δ tháng (giá trị)' = DIVIDE ( [Dư nợ (tỷ)] - [Dư nợ LM (tỷ)], [Dư nợ LM (tỷ)] )
		formatString: 0.0%
		displayFolder: 99 Trung gian
		isHidden

	measure 'Màu Dư nợ Δ tháng' =
			VAR d = [Dư nợ Δ tháng (giá trị)]
			RETURN IF ( ISBLANK ( d ) || d = 0, "#5F5E5A", IF ( d > 0, "#447A2A", "#A32D2D" ) )
		displayFolder: 05 Màu điều kiện

	measure 'Dư nợ Δ cùng kỳ (giá trị)' = DIVIDE ( [Dư nợ (tỷ)] - [Dư nợ LY (tỷ)], [Dư nợ LY (tỷ)] )
		formatString: 0.0%
		displayFolder: 99 Trung gian
		isHidden

