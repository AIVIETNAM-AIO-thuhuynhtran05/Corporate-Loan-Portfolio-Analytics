	measure 'Số ĐVKD đạt cả hai KH' =
			VAR d = MAX ( dim_date[month_end_date] )
			VAR mid = YEAR ( d ) * 100 + MONTH ( d )
			VAR t =
				ADDCOLUMNS (
					VALUES ( dim_branch[branch_id] ),
					"@b", [Dư nợ],
					"@pb", CALCULATE ( SUM ( fact_plan[plan_balance_vnd] ), fact_plan[month_id] = mid ),
					"@n", [NII tháng] * 1e9,
					"@pn", CALCULATE ( SUM ( fact_plan[plan_nii_vnd] ), fact_plan[month_id] = mid )
				)
			VAR tot = COUNTROWS ( FILTER ( t, NOT ISBLANK ( [@pb] ) ) )
			VAR ok = COUNTROWS ( FILTER ( t, NOT ISBLANK ( [@pb] ) && [@b] >= [@pb] && [@n] >= [@pn] ) ) + 0
			RETURN IF ( ISFILTERED ( dim_segment ) || ISFILTERED ( dim_product ) || ISFILTERED ( dim_customer ) || ISBLANK ( tot ), "–", ok & "/" & tot & " ĐVKD" )
		displayFolder: 10 Phân tích sâu\KPI
		lineageTag: 052beecb-882e-4dbf-a51e-35571ec4818e

	measure 'Tỷ lệ OD3-5 loại KV đột biến' = CALCULATE ( [Tỷ lệ OD35], fact_loan_balance[contract_id] <> "AIV-LN-0007842" )
		formatString: 0.00%
		displayFolder: 10 Phân tích sâu\Nợ xấu
